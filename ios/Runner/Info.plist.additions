<!-- Add these entries to the existing Info.plist -->

<!-- BLE Permissions -->
<key>NSBluetoothAlwaysUsageDescription</key>
<string>This app uses Bluetooth to connect to your QCBand health bracelet for real-time health monitoring.</string>
<key>NSBluetoothPeripheralUsageDescription</key>
<string>This app uses Bluetooth to communicate with your QCBand health bracelet.</string>

<!-- Background Modes -->
<key>UIBackgroundModes</key>
<array>
    <string>bluetooth-central</string>
</array>
